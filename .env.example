# Copia este archivo como ".env" (cp .env.example .env) y rellénalo. El archivo .env NO se sube a GitHub.

# ── Respaldo automático de data/ en un repositorio PRIVADO de GitHub ──
# Si no pones estas dos líneas el respaldo queda apagado y el bot funciona igual.
RESPALDO_REPO=usuario/YuiBot-datos
# Token fine-grained limitado a ese repo, con permiso "Contents: Read and write".
RESPALDO_TOKEN=
# Cada cuántos minutos respalda (mínimo 5, por defecto 60).
RESPALDO_CADA_MIN=60
# Archivos de data/ que NO se suben, separados por coma (por defecto las llaves de APIs).
# RESPALDO_EXCLUIR=api-proveedores.json,sync-clave.json
# Rama del repo (por defecto la principal).
# RESPALDO_RAMA=main

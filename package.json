{
  "name": "yuibot-md",
  "version": "1.0.0",
  "description": "YuiBot-MD — Bot de WhatsApp con sistema de comandos extensible (Baileys)",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node -r ./lib/marcar-leido.js main.js",
    "dev": "nodemon -r ./lib/marcar-leido.js main.js",
    "check": "node scripts/check-sintaxis.js",
    "smoke": "node scripts/smoke-check.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "github:russellxz/ultra-baileys#master",
    "@hapi/boom": "^10.0.1",
    "qrcode-terminal": "^0.12.0",
    "pino": "^9.4.0",
    "node-webpmux": "^3.1.0",
    "canvas": "^2.11.2",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}